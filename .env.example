OPENAI_API_KEY=

# GCP (Veo + Gemini via Vertex AI). Project must have billing + Vertex AI API enabled.
GOOGLE_CLOUD_PROJECT=advpost-video
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./advpost-video-27ad9b6f9358.json

# AWS S3 — synced from advpost-server-admin (aws.php / aws_credential)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=advpost
AWS_URL=https://advpost.s3.ap-south-1.amazonaws.com
S3_REQUIRED=1

# Ship generation prompts/status to AdvPost admin (PHP)
ADVPOST_API_BASE_URL=
MEDIA_LOG_SECRET=
MEDIA_LOG_ENABLED=1

# Where generated media is stored: s3 (default) or local.
# local = generated/users/{user_id}/images|videos/ in this project, no S3 upload,
# served at /files/users/{user_id}/... (set MEDIA_PUBLIC_BASE_URL for absolute URLs).
MEDIA_STORAGE=s3

# Local/dev ONLY: keep files on disk and return emulator-reachable URLs
# (Android emulator cannot reliably resolve advpost.s3.*.amazonaws.com).
# Leave both unset in production so clients get S3 URLs.
# KEEP_LOCAL_MEDIA=1
# MEDIA_PUBLIC_BASE_URL=http://10.0.2.2:8000

# ffmpeg to run; must include the drawtext filter for text overlays.
# Default is "ffmpeg" on PATH. macOS: brew install ffmpeg-full, then:
# FFMPEG_BINARY=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
